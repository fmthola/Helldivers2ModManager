    "test:e2e": "node e2e/smoke.test.mjs",
    "test:artifact": "node e2e/artifact.test.mjs",
    "test:regression": "node e2e/regression.test.mjs",
    "test": "pnpm run test:rust && pnpm run test:e2e"
